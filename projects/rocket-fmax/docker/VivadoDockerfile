# chia-vivado: the "vivado" worker of projects/rocket-fmax (vivado_nodes.py).
#
# Vivado itself is NOT in the image: it is installed once on the head under
# ~/tools/Xilinx (Vivado ML Standard, free, Artix-7 only is enough) and mounted
# read-only at /tools/Xilinx by cluster.yaml. The image only adds the libraries
# Vivado needs in batch mode to the base the eda worker uses (Ray + chialoops).
#
# Build on the head (no registry push; cluster.yaml uses pull_before_run: false):
#
#   cd ~/CHIA-workflow/projects/rocket-fmax/docker
#   docker build -f VivadoDockerfile -t chia-vivado:latest .
#
ARG BASE_IMAGE=ghcr.io/ucb-bar/chia-cacti:latest
FROM ${BASE_IMAGE}

USER root
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libtinfo5 libncurses5 libx11-6 libxext6 libxrender1 libxtst6 libxi6 \
      libfreetype6 libfontconfig1 locales \
 && sed -i 's/^# *en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen && locale-gen \
 && rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
USER ray

RUN ray --version && python -c "import chia"
