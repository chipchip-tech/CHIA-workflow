# chia-eda-sky130: the "eda" worker of projects/rocket-fmax.
#
# ghcr.io/ucb-bar/chia-cacti (CACTI + OpenROAD, whose env "eda" already ships the
# standalone `sta` = OpenSTA) plus Yosys in the same env and the
# sky130_fd_sc_hd tt_025C_1v80 liberty, pinned by commit and sha256.
#
# Build on the head (no registry push; cluster.yaml uses pull_before_run: false):
#
#   cd ~/CHIA-workflow/projects/rocket-fmax/docker
#   docker build -f EdaDockerfile -t chia-eda-sky130:latest .
#
ARG BASE_IMAGE=ghcr.io/ucb-bar/chia-cacti:latest
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-cl"]
USER ray

# Yosys from litex-hub, next to OpenROAD/OpenSTA (same channel CactiDockerfile uses).
RUN conda install -y -n eda -c litex-hub -c conda-forge yosys \
 && conda clean -afy

# The google skywater-pdk-libs repo only ships per-cell .lib.json files; the merged
# liberty comes from OpenROAD-flow-scripts (flow/platforms/sky130hd/lib).
ARG ORFS_COMMIT=cca3a717920067d8f6e085ce886fe4ecdc876614
ARG LIB_SHA256=ec0e1067a35c8bf20b11e58d1e8ac53326067e4dac84a125cc1b917a3518d0d9
ENV SKY130HD_LIB=/home/ray/pdk/sky130hd/sky130_fd_sc_hd__tt_025C_1v80.lib
RUN mkdir -p "$(dirname "$SKY130HD_LIB")" \
 && python -c 'import sys, urllib.request as u; u.urlretrieve(sys.argv[1], sys.argv[2])' \
      "https://raw.githubusercontent.com/The-OpenROAD-Project/OpenROAD-flow-scripts/${ORFS_COMMIT}/flow/platforms/sky130hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib" \
      "$SKY130HD_LIB" \
 && echo "${LIB_SHA256}  ${SKY130HD_LIB}" | sha256sum -c -

RUN yosys -V && which sta && ray --version
